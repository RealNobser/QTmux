{
  "cmake.useCMakePresets": "always",
  // Windows: Die Erweiterung darf die VS-Umgebung NICHT selbst injizieren (QTMUX-79).
  // Sie nähme dafür immer die neueste Installation — hier VS 18 — während der Cache
  // auf den Compiler aus VS 2022 zeigt; diese Mischung endet in
  //   error STL1001: Unexpected compiler version, expected MSVC Compiler 19.50
  // Eine Einstellung zur Wahl der VS-Installation gibt es nicht, deshalb kommt die
  // Umgebung deterministisch aus tools\vsdev-build.cmd (vswhere, auf VS 2022 begrenzt),
  // das die Task „CMake: build" aufruft. (Auf macOS/Linux ist die Einstellung wirkungslos.)
  "cmake.useVsDeveloperEnvironment": "never",
  // ⚠️ Folgefehler von „never" (2026-07-28): Der EIGENE Build-Prozess der Erweiterung
  // erbte dann gar keine VS-Umgebung mehr. Compiler und Linker findet Ninja noch über die
  // absoluten Pfade aus dem Cache, aber INCLUDE/LIB fehlen — der Build-Knopf scheiterte an
  //   fatal error C1083: "type_traits": No such file or directory        (INCLUDE fehlt)
  //   LINK : fatal error LNK1104: "iphlpapi.lib" nicht geöffnet          (LIB fehlt)
  // während dasselbe Preset im Release „ging", weil dort nichts zu übersetzen war.
  //
  // ⚠️ `"cmake.buildTask": true` hilft dagegen NICHT und ist deshalb bewusst NICHT gesetzt:
  // die Erweiterung sucht die Task mit `fetchTasks({ type: "cmake" })` (findBuildTask in
  // dist/main.js) — eine `type: shell`-Task findet sie nicht und baut still wieder selbst.
  // Der Weg, der wirklich trägt: die Erweiterung auf den cmake-Wrapper zeigen lassen, der
  // die VS-2022-Umgebung selbst herstellt (Details in tools/cmake-vsdev.cmd):
  //     "cmake.cmakePath": "d:\\projects\\_ClaudeWorkspace\\QTmux\\tools\\cmake-vsdev.cmd"
  // Das gehört in die BENUTZER-Einstellungen und nicht hierher: diese Datei gilt für alle
  // Plattformen, der Pfad existiert nur unter Windows. Ohne den Wrapper bleiben
  // Strg+Umschalt+B und F5 (beide gehen über tasks.json → tools/vsdev-build.cmd) die
  // verlässlichen Wege; der Build-Knopf der Erweiterung scheitert dann an INCLUDE/LIB.
  // Alle drei automatischen Konfigurationsläufe aus: die Erweiterung würde sie mit der
  // leeren Umgebung starten (der Compiler-Test scheitert dann bzw. der Cache wird
  // verdorben) — beim Öffnen, beim Speichern einer CMakeLists.txt und beim Wechsel des
  // Presets in der Statusleiste. Konfiguriert wird ausschließlich im Skript, das jedem
  // Build ein `cmake --preset` voranstellt.
  "cmake.configureOnOpen": false,
  "cmake.configureOnEdit": false,
  "cmake.automaticReconfigure": false,
  "cmake.options.statusBarVisibility": "visible",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/${command:cmake.activeConfigurePresetName}/compile_commands.json",
  "files.associations": {
    "*.qml": "qml"
  }
}
